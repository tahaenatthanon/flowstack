# DirectoryIndex - include PHP files
DirectoryIndex index.php index.html

# Force PHP execution
<FilesMatch \.php$>
    SetHandler application/x-httpd-php
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # --- API: pass directly to PHP (highest priority) ---
  RewriteRule ^api/(.*)$ api/$1 [L,QSA]

  # --- Uploaded files: serve directly ---
  RewriteRule ^uploads/(.*)$ uploads/$1 [L]

  # --- Built assets: /assets/* → dist/assets/* ---
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^assets/(.*)$ dist/assets/$1 [L]

  # --- PWA/static files that live in dist/ root ---
  RewriteRule ^(sw\.js|workbox-[^/]+\.js|manifest\.webmanifest|registerSW\.js|robots\.txt|favicon\.ico|apple-touch-icon\.png|pwa-[^/]+\.png|pwa-[^/]+\.svg|maskable-icon\.png|placeholder\.svg)$ dist/$1 [L]

  # --- SPA catch-all: serve dist/index.html for all other routes ---
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ dist/index.html [L]
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
  ExpiresActive On
  
  # Images
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  
  # CSS & JavaScript
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  
  # Fonts
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  
  # HTML - don't cache
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Gzip compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  
  # PWA MIME types
  AddType application/manifest+json .webmanifest
  
  # Service Worker headers
  <FilesMatch "sw\.js$">
    Header always set Service-Worker-Allowed "/"
  </FilesMatch>
</IfModule>
