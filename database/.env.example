# ============================================================
# Flowstack - Environment Variables Template
# Copy this file to .env and fill in values for your setup
# ============================================================

# ── Frontend & API URLs ────────────────────────────────────────────
# All values auto-detect from browser URL — leave blank unless you need
# to override (e.g. API on different host, or reverse-proxy rewrites).
#
# VITE_API_BASE_URL: Override API base URL
#   Auto:  window.location.origin/api  (e.g. http://host:8080/api)
#   Manual: http://other-host/api
# VITE_API_BASE_URL=

# VITE_APP_URL: Override frontend app URL (used internally, rarely needed)
#   Auto:  window.location.origin
#   Manual: http://platform.ktnbs.com:8080
# VITE_APP_URL=

# APP_URL: Base URL for building public links (survey, email tracking, etc.)
#   Auto:  http(s):// + HTTP_HOST (request host header, includes port)
#   Manual: http://platform.ktnbs.com:8080
# APP_URL=

KILO_API_TOKEN=
KILO_API_BASE_URL=

# ── SMTP / Email Settings ──────────────────────────────────────
# ตั้งค่า SMTP สำหรับส่งอีเมล (PHPMailer)
# Gmail example: smtp.gmail.com:587 + App Password (ต้องเปิด 2FA ก่อน)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=your@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM_ADDRESS=your@gmail.com
MAIL_FROM_NAME=Flowstack
